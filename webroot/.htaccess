# Phabricator – Apache rewrite rules
# Works on shared hosting without VirtualHost access (e.g. InfinityFree, 000webhost).
# Place this file (or symlink it) into the webroot/ directory.

Options -MultiViews -Indexes

RewriteEngine On

# Serve existing files and directories directly (CSS, JS, images)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through Phabricator
RewriteRule ^(.*)$ index.php?__path__=/$1 [B,L,QSA]

# PHP settings for shared hosting (override defaults where allowed)
# Increase limits for large diffs and file uploads
php_value memory_limit 256M
php_value post_max_size 32M
php_value upload_max_filesize 32M
php_value max_execution_time 120
php_flag expose_php Off
