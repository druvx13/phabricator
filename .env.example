# .env.example – copy to .env and fill in your values
# Used by docker-compose.yml

# Full base URI of your Phabricator install (must end with /)
PHABRICATOR_BASE_URI=http://localhost/

# MariaDB root password (only used by the Docker db container)
DB_ROOT_PASSWORD=change_this_root_password

# Password for the 'phabricator' database user
DB_PASSWORD=change_this_db_password
