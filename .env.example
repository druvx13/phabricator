# .env – Phabricator configuration
#
# QUICK DEPLOY STEPS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below (at minimum: BASE_URI, MYSQL_*)
#   3. Upload the whole project to your web host
#   4. Visit  http://yoursite/install.php  to set up the database
#   5. Delete install.php after setup is complete
#
# All values are automatically applied on every request by support/preamble.php
# — no CLI commands needed.

# ── Required ─────────────────────────────────────────────────────────────────

# Full URL of your Phabricator install, including trailing slash
PHABRICATOR_BASE_URI=http://yoursite.example.com/

# MySQL / MariaDB connection
# On shared hosting (cPanel / InfinityFree): use 'localhost' and the DB user
# credentials from your hosting control panel.
PHABRICATOR_MYSQL_HOST=localhost
PHABRICATOR_MYSQL_PORT=3306
PHABRICATOR_MYSQL_USER=YOUR_DB_USER
PHABRICATOR_MYSQL_PASS=YOUR_DB_PASSWORD

# ── Shared Hosting: Database prefix & explicit DB list ────────────────────────
#
# PHABRICATOR_NAMESPACE
#   The prefix used for all Phabricator databases.
#   On InfinityFree / cPanel this MUST equal your MySQL account username
#   (e.g. nhyfe_40946451), because all databases must be named
#   username_suffix (e.g. nhyfe_40946451_almanac).
#
#   ⚠  Do NOT use the default 'phabricator' — your host will deny access to
#   any database not prefixed with your username.
#
PHABRICATOR_NAMESPACE=YOUR_CPANEL_USERNAME

# PHABRICATOR_DB_LIST  (required on shared hosting)
#   Comma-separated list of every database you have manually created in cPanel.
#   Phabricator needs 57 databases. The installer at /install.php will:
#     1. Show you the full list of required names based on PHABRICATOR_NAMESPACE.
#     2. Provide a "Copy PHABRICATOR_DB_LIST for .env" button.
#   Copy that line here after creating all databases in cPanel.
#
#   When this variable is set, the installer skips CREATE DATABASE (which is
#   blocked on shared hosting) and uses your pre-created databases directly.
#   When left blank, the installer falls back to auto-detection (for VPS use).
#
#   Example for InfinityFree user nhyfe_40946451:
# PHABRICATOR_DB_LIST=nhyfe_40946451_almanac,nhyfe_40946451_application,nhyfe_40946451_audit,...
#
PHABRICATOR_DB_LIST=

# Server timezone (PHP timezone string)
# List: https://www.php.net/manual/en/timezones.php
PHABRICATOR_TIMEZONE=UTC

# ── Email / SMTP (optional) ───────────────────────────────────────────────────

# From address for outgoing Phabricator mail
PHABRICATOR_FROM_EMAIL=noreply@yoursite.example.com

# SMTP settings (leave blank to use PHP's mail() function)
PHABRICATOR_SMTP_HOST=
PHABRICATOR_SMTP_PORT=587
PHABRICATOR_SMTP_USER=
PHABRICATOR_SMTP_PASS=
# Protocol: ssl or tls
PHABRICATOR_SMTP_PROTO=tls

# ── File / Repository Storage (optional) ─────────────────────────────────────

# Local filesystem path for repository data
# Must be writable by the web server user.
# On shared hosting this can be a directory inside your hosting space.
PHABRICATOR_REPO_PATH=/var/repo

# Local filesystem path for uploaded files
PHABRICATOR_FILES_PATH=/var/phabricator/files

# ── Docker / CI only ─────────────────────────────────────────────────────────

# Root password for the MariaDB container (only used by docker-compose.yml)
DB_ROOT_PASSWORD=change_this_root_password

