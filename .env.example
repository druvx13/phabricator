# .env – Phabricator configuration
#
# QUICK DEPLOY STEPS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below (at minimum: BASE_URI, MYSQL_*)
#   3. Upload the whole project to your web host
#   4. Visit  http://yoursite/install.php  to set up the database
#   5. Delete install.php after setup is complete
#
# All values are automatically applied on every request by support/preamble.php
# — no CLI commands needed.

# ── Required ─────────────────────────────────────────────────────────────────

# Full URL of your Phabricator install, including trailing slash
PHABRICATOR_BASE_URI=http://yoursite.example.com/

# MySQL / MariaDB connection
# On shared hosting (cPanel): use 'localhost', and the DB user/pass
# from your hosting control panel.
PHABRICATOR_MYSQL_HOST=localhost
PHABRICATOR_MYSQL_PORT=3306
PHABRICATOR_MYSQL_USER=phabricator
PHABRICATOR_MYSQL_PASS=YOUR_DB_PASSWORD

# ── Recommended ──────────────────────────────────────────────────────────────

# Prefix used for all Phabricator databases (e.g. 'phabricator' → phabricator_user, etc.)
# On shared hosting with a single-DB limit, set this to your existing DB name prefix.
PHABRICATOR_NAMESPACE=phabricator

# Server timezone (PHP timezone string)
# List: https://www.php.net/manual/en/timezones.php
PHABRICATOR_TIMEZONE=UTC

# ── Email / SMTP (optional) ───────────────────────────────────────────────────

# From address for outgoing Phabricator mail
PHABRICATOR_FROM_EMAIL=noreply@yoursite.example.com

# SMTP settings (leave blank to use PHP's mail() function)
PHABRICATOR_SMTP_HOST=
PHABRICATOR_SMTP_PORT=587
PHABRICATOR_SMTP_USER=
PHABRICATOR_SMTP_PASS=
# Protocol: ssl or tls
PHABRICATOR_SMTP_PROTO=tls

# ── File / Repository Storage (optional) ─────────────────────────────────────

# Local filesystem path for repository data
# Must be writable by the web server user.
# On shared hosting this can be a directory inside your hosting space.
PHABRICATOR_REPO_PATH=/var/repo

# Local filesystem path for uploaded files
PHABRICATOR_FILES_PATH=/var/phabricator/files

# ── Docker / CI only ─────────────────────────────────────────────────────────

# Root password for the MariaDB container (only used by docker-compose.yml)
DB_ROOT_PASSWORD=change_this_root_password

